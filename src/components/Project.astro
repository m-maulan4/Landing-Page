---
import data from "../data.json";
---

<section id="project" class="border-t-4">
  <div class="section-header">
    <div class="left">
      <h4 class="bg-brutal-green">01/</h4>
      <h3>Daftar <span class="bg-brutal-blue text-white">Project</span></h3>
    </div>
    <div class="right">Kumpulan project yang telah saya kerjakan</div>
  </div>
  <div class="section-content">
    {
      data.map((item, key) => (
        <di class="card-project">
          <div class="relative flex items-center justify-between bg-black text-white uppercase p-2 tracking-widest">
            <span class="bg-brutal-orange px-3 font-mono text-lg">
              #0{key + 1}
            </span>
            <span class="absolute z-10 top-2 -right-3 border-2 bg-brutal-green text-black font-bold rotate-25 px-2 py-1">
              {item.dev}
            </span>
          </div>
          <img src="#" alt="" class="aspect-video bg-pink-400" />
          <div class="p-4">
            <h2 class="font-bold text-2xl">{item.title}</h2>
            <p class="leading-relaxed line-clamp-3 mb-4">{item.desc}</p>
            <div class="w-full border-t-2 border-dashed pt-2 text-black uppercase flex flex-wrap gap-4">
              {item.stack.map((d) => (
                <span class="bg-brutal-blue shadow-brutal-xs font-semibold tracking-wide py-0.5 px-2 text-center">
                  {d}
                </span>
              ))}
            </div>
          </div>
          <div class="p-4 flex items-center justify-between flex-wrap border-t-4 font-medium">
            <span>2025</span>
            <a
              href={item.url}
              class="px-2 py-0.5 shadow-brutal-xs transition-all ease-linear hover:shadow-none border-2"
            >
              DEMO
            </a>
          </div>
        </di>
      ))
    }
  </div>
</section>
