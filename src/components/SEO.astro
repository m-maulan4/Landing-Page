---
const site = Astro.site ?? new URL("https://maulana.my.id/");
const ogImage = new URL("img/og-preview.webp", site).href;
---

<title>Muammar Maulana | Junior Full Stack Web Developer</title>
<meta
  name="description"
  content="Portofolio Muammar Maulana, Junior Full Stack Web Developer yang menguasai HTML, CSS, JavaScript, React, Node.js, dan MongoDB. Terbuka untuk peluang remote & freelance."
/>
<meta
  name="keywords"
  content="junior full stack developer, web developer pemula, react developer indonesia, nodejs developer, freelance web developer, portofolio web developer"
/>
<meta name="author" content="Muammar Maulana" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={site.href} />

<!-- ===== OPEN GRAPH (Facebook, LinkedIn, WhatsApp) ===== -->
<meta property="og:type" content="website" />
<meta
  property="og:title"
  content="Muammar Maulana | Junior Full Stack Web Developer"
/>
<meta
  property="og:description"
  content="Junior Full Stack Developer spesialis Laravel, React, & Node.js. Lihat portofolio dan proyek saya."
/>
<meta property="og:url" content={site.href} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content="Muammar Maulana" />

<!-- ===== TWITTER (X) ===== -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Muammar Maulana | Junior Full Stack Web Developer" />
<meta name="twitter:description" content="Junior Full Stack Developer spesialis Laravel, React, & Node.js. Lihat portofolio dan proyek saya." />
<meta name="twitter:image" content={ogImage} />

<!-- ===== JSON-LD STRUCTURED DATA (SEO KILLER!) ===== -->
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Muammar Maulana",
    "jobTitle": "Junior Full Stack Web Developer",
    "url": "https://maulana.my.id",
    "sameAs": [
      "https://github.com/m-maulan4",
      "https://www.instagram.com/maulana69_"
    ],
    "knowsAbout": [
      "HTML",
      "CSS",
      "JavaScript",
      "Laravel",
      "React",
      "Node.js",
      "MongoDB",
      "Express.js"
    ]
  }
</script>
